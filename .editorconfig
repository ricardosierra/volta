root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 100

[*.gd]
indent_style = tab
indent_size = 4

[*.{tscn,tres,godot,import,cfg}]
indent_style = tab
insert_final_newline = false
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_style = space
indent_size = 2

[*.php]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
