# =============================================================================
# VOLTA — variáveis de ambiente (copie para .env; NUNCA versione .env)
# =============================================================================
# Nada aqui é lido pelo cliente Godot em runtime de produção. Chaves de cliente
# são injetadas em build time por tools/ci (ver docs/deployment/release-process.md).

# ── Cliente / build (GSD 01, 21, 22) ─────────────────────────────────────────
GODOT_VERSION=4.3-stable
GODOT_BIN=godot
VOLTA_ENV=development                    # development | staging | production
VOLTA_DEBUG_TOOLS=true                   # false obrigatoriamente em release
VOLTA_LOG_LEVEL=debug                    # debug | info | warn | error

# ── Android (GSD 21) ─────────────────────────────────────────────────────────
ANDROID_SDK_ROOT=
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
ANDROID_PACKAGE_NAME=com.ricardosierra.volta

# ── iOS (GSD 22) ─────────────────────────────────────────────────────────────
IOS_TEAM_ID=
IOS_BUNDLE_ID=com.ricardosierra.volta
IOS_PROVISIONING_PROFILE=

# ── API Laravel (GSD 15) ─────────────────────────────────────────────────────
APP_NAME=VoltaAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=volta
DB_USERNAME=volta
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Integração cliente ↔ API (GSD 16) ────────────────────────────────────────
VOLTA_API_BASE_URL=http://localhost:8000/api/v1
VOLTA_API_TIMEOUT_MS=8000
VOLTA_SCORE_HMAC_SECRET=                 # servidor: valida assinatura de partida

# ── Analytics / crash (GSD 18) — adapters, nunca acoplados ao gameplay ───────
VOLTA_ANALYTICS_PROVIDER=noop            # noop | local | remote
VOLTA_CRASH_PROVIDER=noop
