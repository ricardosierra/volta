; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VOLTA"
config/version="0.1.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/brand/volta_app_icon.png"
config/macos_native_icon="res://assets/brand/volta_app_icon.png"
config/windows_native_icon="res://assets/brand/volta_app_icon.png"
config/android_adaptive_icon="res://assets/brand/volta_app_icon.png"
config/android_adaptive_icon_background="res://assets/brand/volta_app_icon.png"
config/ios_icon="res://assets/brand/volta_app_icon.png"

[autoload]

Bootstrap="*res://src/core/bootstrap.gd"
Log="*res://src/core/log/log.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
